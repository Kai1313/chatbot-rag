# ==============================================================================
# Hybrid RAG Chatbot & Tracking Engine Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials (Navicat / HeidiSQL / DBeaver Access)
# ------------------------------------------------------------------------------
POSTGRES_DB=local_db
POSTGRES_USER=local_user
POSTGRES_PASSWORD=local_password
POSTGRES_HOST=db
POSTGRES_PORT=5431
DATABASE_URL=postgresql://local_user:local_password@db:5432/local_db

# Local database URL for running backend scripts outside Docker container:
# LOCAL_DATABASE_URL=postgresql://local_user:local_password@localhost:5431/local_db

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: deepseek, gemini, groq, openai, ollama
# ------------------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# API Keys (Provide key for your chosen provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Ollama local endpoint (if using LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ------------------------------------------------------------------------------
# Document Storage Provider Settings
# Supported storage drivers: 'local' (default/self-hosted), 'gdrive', 's3'
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/documents
BASE_API_URL=http://localhost:8080

# If using Google Drive cloud storage (optional):
# GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
# GOOGLE_DRIVE_FOLDER_ID=your_shared_drive_folder_id

# ------------------------------------------------------------------------------
# Backend, Dataset & Vector DB Settings
# ------------------------------------------------------------------------------
DATASET_PATH=PERIZINAN_PBG_2.xlsx
CHROMA_DB_DIR=./data/chroma
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
